<!DOCTYPE html>
<html>
<head>
<title>AMSI Policy Test - mshta Launch</title>
<HTA:APPLICATION
    ID="AmsiTestHta"
    APPLICATIONNAME="AMSI Policy Test"
    SCROLL="no"
    SINGLEINSTANCE="yes"
/>
<script language="VBScript">
Sub RunTest
    Dim shell
    Set shell = CreateObject("WScript.Shell")

    ' Opens a visible PowerShell console, runs the command, and
    ' pauses so the window stays open and you can read the output.
    ' Replace Invoke-Expression "Get-Date" with your blocked command as needed.
    shell.Run "powershell.exe -NoExit -NoProfile -Command ""Invoke-Expression 'Get-Date'""", 1, False

    window.close
End Sub
</script>
</head>
<body onload="RunTest">
</body>
</html>
