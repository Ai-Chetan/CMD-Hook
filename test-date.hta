<!DOCTYPE html>
<html>
<head>
    <script language="JScript">
        var shell = new ActiveXObject("WScript.Shell");
        var cmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Get-Date"';
        var exec = shell.Exec(cmd);
        var output = exec.StdOut.ReadAll();
        alert("Current date/time: " + output);
        window.close();
    </script>
</head>
<body></body>
</html>
